# Local development only. Never commit real secrets.
NODE_ENV=development
DATABASE_URL=postgresql://srip:srip_dev@localhost:5432/srip?schema=public
REDIS_URL=redis://localhost:6379
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
JWT_SECRET=CHANGE_ME_LOCAL_ONLY_MIN_32_CHARS

# Integration OAuth token encryption (32-byte key; 64 hex chars or base64)
SECRET_ENCRYPTION_KEY=
SECRET_ENCRYPTION_KEY_VERSION=v1
# Previous rotation keys, when required, use SECRET_ENCRYPTION_KEY_<VERSION>, e.g. SECRET_ENCRYPTION_KEY_V1
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URI=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=srip
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Background job infrastructure
REDIS_URL=redis://localhost:6379
QUEUE_WORKER_ENABLED=false
QUEUE_CONCURRENCY=5
QUEUE_MAX_ATTEMPTS=5
QUEUE_BACKOFF_MS=2000
QUEUE_RATE_LIMIT_MAX=100
QUEUE_RATE_LIMIT_DURATION_MS=1000

# Phase 26 additions — see apps/api/.env.example for the full, authoritative list
SMTP_HOST=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
TRUSTED_ORIGINS=http://localhost:3000

# Data quality operational threshold (Master Spec requires stale relationship detection; threshold is configurable)
DATA_QUALITY_STALE_DAYS=90
IMPORT_MAX_BYTES=26214400
# Production observability
OTEL_TRACING_ENABLED=true
OTEL_SERVICE_NAME=srip-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
QUEUE_METRICS_INTERVAL_MS=15000

S3_REQUIRED=false

# Backup / PITR / Disaster Recovery
BACKUP_S3_URI=s3://replace-with-backup-bucket/srip
BACKUP_S3_SSE=AES256
BACKUP_S3_KMS_KEY_ID=
BACKUP_ENCRYPTION_KEY=replace-with-32-byte-secret
BACKUP_RETENTION_DAYS=35
BACKUP_INTERVAL_SECONDS=86400
WAL_ARCHIVE_TIMEOUT=60s
RPO_TARGET_MINUTES=15
RTO_TARGET_MINUTES=60
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# PHASE AA — Distributed Redis-backed API rate limits
RATE_LIMIT_FAIL_OPEN=false
RATE_LIMIT_GLOBAL_MAX=10000
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_IP_MAX=500
RATE_LIMIT_IP_WINDOW_MS=60000
RATE_LIMIT_USER_MAX=1000
RATE_LIMIT_USER_WINDOW_MS=60000
RATE_LIMIT_ENDPOINT_MAX=120
RATE_LIMIT_ENDPOINT_WINDOW_MS=60000
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_PASSWORD_RESET_MAX=5
RATE_LIMIT_PASSWORD_RESET_WINDOW_MS=900000
RATE_LIMIT_MFA_MAX=10
RATE_LIMIT_MFA_WINDOW_MS=300000
RATE_LIMIT_EXPORT_MAX=20
RATE_LIMIT_EXPORT_WINDOW_MS=600000
RATE_LIMIT_SEARCH_MAX=120
RATE_LIMIT_SEARCH_WINDOW_MS=60000
RATE_LIMIT_BULK_IMPORT_MAX=10
RATE_LIMIT_BULK_IMPORT_WINDOW_MS=600000
RATE_LIMIT_WEBHOOK_MAX=300
RATE_LIMIT_WEBHOOK_WINDOW_MS=60000
RATE_LIMIT_SENSITIVE_MAX=30
RATE_LIMIT_SENSITIVE_WINDOW_MS=60000

# Prometheus /metrics source networks. Keep this limited to the internal monitoring network.
METRICS_ALLOWED_CIDRS=127.0.0.1/32,::1/128
