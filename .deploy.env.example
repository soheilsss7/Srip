# ─── پیکربندی دیپلوی روی هاست خودتان (این فایل را کپی کنید: cp .deploy.env.example .deploy.env) ───
# ⚠️ .deploy.env در .gitignore است و هرگز commit نمی‌شود.

# آدرس SSH/SFTP هاست (Plesk: نام کاربری‌ای که دسترسی SSH دارد)
SRIP_DEPLOY_HOST=ftp.your-domain.com
SRIP_DEPLOY_USER=yourpleskuser
SRIP_DEPLOY_PORT=22

# کلید خصوصی (اختیاری — اگر از password استفاده می‌کنید خالی بگذارید و در Plesk
# کلید عمومی اضافه کنید). Plesk: Subscriptions → domain → Access → SSH Keys.
SRIP_DEPLOY_SSH_KEY=/home/you/.ssh/id_ed25519

# مسیر document root روی سرور. در Plesk معمولاً:
#   ~/httpdocs  (اگر کاربر SSH همان دارندهٔ سابسکریپشن باشد)
#   یا /var/www/vhosts/your-domain.com/httpdocs
SRIP_DEPLOY_DOCROOT=~/httpdocs

# نام پوشهٔ مقصد (زیر httpdocs) → آدرس نهایی: https://your-domain.com/srip
SRIP_DEPLOY_SUBPATH=srip

# مسیر URL build (باید با نام پوشه یکی باشد؛ معمولاً لازم به تغییر نیست)
# SRIP_BASE_PATH=/srip

# ۱= فقط build و دستورها را نشان بده، آپلود نکن
# SRIP_DEPLOY_DRY_RUN=1
