DATABASE_URL=postgresql://srip:srip@localhost:5432/srip
REDIS_URL=redis://localhost:6379
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
JWT_SECRET=change-this-for-local-development
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URI=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=srip
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Background job infrastructure
REDIS_URL=redis://localhost:6379
QUEUE_WORKER_ENABLED=false
QUEUE_CONCURRENCY=5
QUEUE_MAX_ATTEMPTS=5
QUEUE_BACKOFF_MS=2000
QUEUE_RATE_LIMIT_MAX=100
QUEUE_RATE_LIMIT_DURATION_MS=1000

# Authentication & Identity (production should use OIDC)
AUTH_MODE=oidc
AUTH_REQUIRE_EMAIL_VERIFICATION=true
SESSION_IDLE_TTL_MS=28800000
SESSION_ABSOLUTE_TTL_MS=2592000000
MFA_ENCRYPTION_KEY=replace-with-a-secret-manager-value
OIDC_DEFAULT_REDIRECT_URI=http://localhost:3000/auth/oidc/callback
# Primary OIDC provider
OIDC_PRIMARY_ISSUER=https://identity.example.com
OIDC_PRIMARY_CLIENT_ID=replace-me
OIDC_PRIMARY_CLIENT_SECRET=replace-me
OIDC_PRIMARY_SCOPES=openid profile email
# Optional dedicated Google/Microsoft OIDC providers
OIDC_GOOGLE_ISSUER=https://accounts.google.com
OIDC_GOOGLE_CLIENT_ID=replace-me
OIDC_GOOGLE_CLIENT_SECRET=replace-me
OIDC_MICROSOFT_ISSUER=https://login.microsoftonline.com/common/v2.0
OIDC_MICROSOFT_CLIENT_ID=replace-me
OIDC_MICROSOFT_CLIENT_SECRET=replace-me
OIDC_ALLOWED_REDIRECT_URIS=http://localhost:3000/auth/oidc/callback

# File security
FILE_MAX_BYTES=26214400
FILE_SCAN_REQUIRED=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000
S3_SERVER_SIDE_ENCRYPTION=AES256

# Phase 26 — Notification delivery (optional; app works without these, but
# Email/Push will be logged-only instead of actually delivered until set)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@srip.local
VAPID_SUBJECT=mailto:admin@srip.local
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Phase 26 — Origin verification (defense-in-depth; this API is Bearer-token
# only, so classic CSRF does not apply, but this blocks unexpected
# cross-origin state-changing calls anyway)
TRUSTED_ORIGINS=http://localhost:3000
ORIGIN_CHECK_ENFORCED=true

# PHASE AA — Distributed Redis-backed API rate limits
RATE_LIMIT_FAIL_OPEN=false
RATE_LIMIT_GLOBAL_MAX=10000
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_IP_MAX=500
RATE_LIMIT_IP_WINDOW_MS=60000
RATE_LIMIT_USER_MAX=1000
RATE_LIMIT_USER_WINDOW_MS=60000
RATE_LIMIT_ENDPOINT_MAX=120
RATE_LIMIT_ENDPOINT_WINDOW_MS=60000
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_PASSWORD_RESET_MAX=5
RATE_LIMIT_PASSWORD_RESET_WINDOW_MS=900000
RATE_LIMIT_MFA_MAX=10
RATE_LIMIT_MFA_WINDOW_MS=300000
RATE_LIMIT_EXPORT_MAX=20
RATE_LIMIT_EXPORT_WINDOW_MS=600000
RATE_LIMIT_SEARCH_MAX=120
RATE_LIMIT_SEARCH_WINDOW_MS=60000
RATE_LIMIT_BULK_IMPORT_MAX=10
RATE_LIMIT_BULK_IMPORT_WINDOW_MS=600000
RATE_LIMIT_WEBHOOK_MAX=300
RATE_LIMIT_WEBHOOK_WINDOW_MS=60000
RATE_LIMIT_SENSITIVE_MAX=30
RATE_LIMIT_SENSITIVE_WINDOW_MS=60000

# Prometheus /metrics source networks. Keep this limited to the internal monitoring network.
METRICS_ALLOWED_CIDRS=127.0.0.1/32,::1/128

# PHASE AL Performance
DB_SLOW_QUERY_MS=250
PERFORMANCE_CACHE_ENABLED=true
# Prisma PostgreSQL pooling: add connection_limit / pool_timeout to DATABASE_URL for deployment-specific sizing.
