    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "jest": "^30.0.2",
    "prisma": "^6.15.0",
    "ts-jest": "^29.4.1",
    "@types/multer": "^2.0.0",
    "typescript": "^5.9.2",
    "tsx": "^4.19.2",
    "@types/nodemailer": "^6.4.17",
    "@types/web-push": "^3.6.4",
    "@types/pdfkit": "^0.13.8"
  }
