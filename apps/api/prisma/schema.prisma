datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
generator client {
  provider = "prisma-client-js"
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}
enum OrganizationType {
  HOLDING
  SUBSIDIARY
  CUSTOMER
  PARTNER
  BANK
  GOVERNMENT
  INVESTOR
  SUPPLIER
  OTHER
}
enum RelationshipStatus {
  PROSPECTIVE
  ACTIVE
  AT_RISK
  DORMANT
  ARCHIVED
}
enum RelationshipLifecycleStage {
  IDENTIFIED
  INTRODUCED
  INITIAL_CONTACT
  DEVELOPING
  ACTIVE
  STRATEGIC
  DORMANT
  AT_RISK
  LOST
}
enum InteractionKind {
  CALL
  EMAIL
  MEETING
  NOTE
  MESSAGE
  OTHER

  @@map("InteractionKind")
}
enum ActionStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}
enum CommitmentStatus {
  OPEN
  FULFILLED
  OVERDUE
  CANCELLED
}
enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}
enum RequirementStatus {
  OPEN
  IN_PROGRESS
  SATISFIED
  BLOCKED
  CANCELLED
}
enum OpportunityStatus {
  IDENTIFIED
  QUALIFYING
  ACTIVE
  WON
  LOST
}
enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}
enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ALERT
}
enum AuditAction {
  CREATE
  READ
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  PERMISSION_CHANGE
  TAG_CREATED
  TAG_UPDATED
  TAG_ASSIGNED
  TAG_REMOVED
  CUSTOM_FIELD_CREATED
  CUSTOM_FIELD_UPDATED
  CUSTOM_FIELD_DELETED
  CUSTOM_FIELD_VALUE_SET
  CUSTOM_FIELD_VALUE_REMOVED
  SOFT_DELETE
  RESTORE
  PERMANENT_DELETE
  DELETE_APPROVAL_REQUESTED
  DELETE_APPROVED
  DELETE_REJECTED
  APPROVAL_REQUESTED
  APPROVAL_APPROVED
  APPROVAL_REJECTED
  APPROVAL
  TOKEN_CHANGE
  INTEGRATION_CHANGE
}
enum DataClassification {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  RESTRICTED
  PRIVATE
  HIGHLY_CONFIDENTIAL
}
enum PrivacyRequestType {
  ACCESS
  EXPORT
  ERASURE
}
enum PrivacyRequestStatus {
  PENDING
  PROCESSING
  COMPLETED
  REJECTED
}
enum ConsentStatus {
  GRANTED
  REVOKED
}
enum DataLifecycleState {
  CREATION
  ACTIVE
  ARCHIVED
  RETENTION
  DELETION
  RESTORED
  PURGED
}
enum DataDeletionApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}
enum LegalBasis {
  CONSENT
  CONTRACT
  LEGAL_OBLIGATION
  LEGITIMATE_INTEREST
  VITAL_INTEREST
  PUBLIC_TASK
}
enum FileUploadStatus {
  QUARANTINED
  READY
  REJECTED
}
enum FileScanStatus {
  PENDING
  CLEAN
  INFECTED
  ERROR
  NOT_REQUIRED
}
enum AccessScopeType {
  ORGANIZATION
  SUBSIDIARIES
  DEPARTMENT
  OWNED
  SHARED
  PRIVATE
}
enum TokenType {
  PASSWORD_RESET
  EMAIL_VERIFICATION
}
enum AuthProvider {
  LOCAL
  OIDC
  SAML
}
enum SecurityEventSeverity {
  INFO
  WARNING
  HIGH
  CRITICAL
}
enum SecurityEventType {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  ACCOUNT_LOCKED
  PERMISSION_DENIED
  RATE_LIMITED
  SUSPICIOUS_ACCESS
  EXPORT_CREATED
  MFA_EVENT
}
enum IntegrationProvider {
  GOOGLE
  MICROSOFT
}
enum IntegrationKind {
  CALENDAR
  EMAIL
  DRIVE
  TEAMS
  SHAREPOINT
}
enum IntegrationStatus {
  PENDING
  CONNECTED
  ERROR
  DISCONNECTED
}
enum ReferralStatus {
  PENDING
  ACCEPTED
  DECLINED
  COMPLETED
  CANCELLED
}
enum ConnectionPathType {
  DIRECT
  ONE_HOP
  TWO_HOP
  MULTI_HOP
}
enum MilestoneStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  BLOCKED
  CANCELLED
}
enum MeetingStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}
enum ImportEntityType {
  ORGANIZATION
  PERSON
}
enum ImportFormat {
  CSV
  XLSX
  XLS
}
enum ImportStatus {
  UPLOADED
  MAPPED
  VALIDATING
  PREVIEWED
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
  FAILED
}
enum ImportRowStatus {
  VALID
  INVALID
  DUPLICATE
  IMPORTED
  SKIPPED
  UPDATED
}
enum DuplicateStrategy {
  SKIP
  UPDATE
  CREATE
}
enum ImportPipelineStage {
  UPLOAD
  MAPPING
  VALIDATION
  DUPLICATE_DETECTION
  PREVIEW
  APPROVAL
  IMPORT
  REPORT
}




model IdempotencyRecord {
  id String @id @default(uuid())
  keyHash String @unique
  requestHash String
  method String
  path String
  userId String?
  statusCode Int
  responseJson Json?
  responseBodyBase64 String?
  responseHeaders Json?
  createdAt DateTime @default(now())
  expiresAt DateTime
  @@index([userId, createdAt])
  @@index([path, createdAt])
  @@index([expiresAt])
}

model User {
  id String @id @default(uuid())
  email String @unique
  name String
  passwordHash String?
  isActive Boolean @default(true)
  failedLoginCount Int @default(0)
  lockedUntil DateTime?
  passwordChangedAt DateTime?
  emailVerifiedAt DateTime?
  lastLoginAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workflowApprovalsRequested WorkflowApproval[] @relation("WorkflowApprovalRequestedBy")
  workflowApprovalsDecided WorkflowApproval[] @relation("WorkflowApprovalDecidedBy")
  approvalRequestsRequested ApprovalRequest[] @relation("ApprovalRequestRequestedBy")
  approvalRequestsDecided ApprovalRequest[] @relation("ApprovalRequestDecidedBy")

  deletedAt DateTime?
  deletedById String?
  deletedBy User? @relation("UserDeletedBy", fields: [deletedById], references: [id])
  memberships Membership[]
  interactions Interaction[]
  meetings Meeting[] @relation("MeetingOwner")
  actions Action[] @relation("ActionOwner")
  createdActions Action[] @relation("ActionCreator")
  commitments Commitment[] @relation("CommitmentOwner")
  auditLogs AuditLog[]
  securityEvents SecurityEvent[]
  dataExports DataExportLog[]
  notifications Notification[]
  savedSearches SavedSearch[]
  notificationPreference NotificationPreference?
  notificationDeliveryLogs NotificationDeliveryLog[]
  notificationRuleDeliveries NotificationRuleDelivery[]
  pushSubscriptions PushSubscription[]
  recommendations Recommendation[]
  referralsDeletedBy Referral[] @relation("ReferralDeletedBy")
  integrationConnectionsDeletedBy IntegrationConnection[] @relation("IntegrationConnectionDeletedBy")
  dataDeletionRequests DataDeletionApproval[] @relation("DataDeletionRequestedBy")
  dataDeletionApprovals DataDeletionApproval[] @relation("DataDeletionApprovedBy")
  dataLifecycleRecords DataLifecycleRecord[] @relation("DataLifecycleActor")
  sessions Session[]
  loginHistory LoginHistory[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  accounts Account[]
  mfaDevices MfaDevice[]
  recoveryCodes RecoveryCode[]
  authorizationPolicies AuthorizationPolicy[] @relation("PolicyUser")
  deletedUsers User[] @relation("UserDeletedBy")
  deletedByUsers Organization[] @relation("OrganizationDeletedBy")
  tagAssignments TagAssignment[] @relation("TagAssignmentCreatedBy")
  deletedPeople Person[] @relation("PersonDeletedBy")
  deletedRelationships Relationship[] @relation("RelationshipDeletedBy")
  deletedInteractions Interaction[] @relation("InteractionDeletedBy")
  deletedMeetings Meeting[] @relation("MeetingDeletedBy")
  deletedActions Action[] @relation("ActionDeletedBy")
  deletedCommitments Commitment[] @relation("CommitmentDeletedBy")
  deletedProjects Project[] @relation("ProjectDeletedBy")
  deletedRequirements ProjectRequirement[] @relation("RequirementDeletedBy")
  deletedOpportunities Opportunity[] @relation("OpportunityDeletedBy")
  deletedNotes Note[] @relation("NoteDeletedBy")
  deletedDocuments Document[] @relation("DocumentDeletedBy")
  deletedNotifications Notification[] @relation("NotificationDeletedBy")
  deletedRecommendations Recommendation[] @relation("RecommendationDeletedBy")
  deletedWorkflows Workflow[] @relation("WorkflowDeletedBy")
  createdNotes Note[] @relation("NoteCreatedBy")
  createdDocuments Document[] @relation("DocumentCreatedBy")
  relationshipOwners Relationship[] @relation("RelationshipOwner")
  relationshipBackupOwners Relationship[] @relation("RelationshipBackupOwner")
  personRelationshipOwners PersonRelationship[] @relation("PersonRelationshipOwner")
  personRelationshipBackupOwners PersonRelationship[] @relation("PersonRelationshipBackupOwner")
  personRelationshipDeletions PersonRelationship[] @relation("PersonRelationshipDeletedBy")
  projectOwners Project[] @relation("ProjectOwner")
  organizationOwners Organization[] @relation("OrganizationOwner")
  scoreVersionsCreated ScoreVersion[] @relation("ScoreVersionCreator")

  customFieldsCreated CustomField[] @relation("CustomFieldCreatedBy")
  scoringRulesCreated ScoringRule[] @relation("ScoringRuleCreatedBy")
  notificationRulesCreated NotificationRule[] @relation("NotificationRuleCreatedBy")
  aiSettingsUpdated AiSetting[] @relation("AiSettingUpdatedBy")
  analyticsEvents AnalyticsEvent[]
  integrationConnections IntegrationConnection[]
  referralsCreated Referral[] @relation("ReferralCreatedBy")
  referralsReceived Referral[] @relation("ReferralRecipient")
  projectRisks ProjectRisk[]
  projectMilestones ProjectMilestone[]
  connectionPaths ConnectionPath[] @relation("ConnectionPathCreatedBy")
  privacyRequests PrivacyRequest[]
  consentRecords ConsentRecord[]
  dataImportsRequested DataImport[] @relation("DataImportRequestedBy")
  dataImportsApproved DataImport[] @relation("DataImportApprovedBy")
  dataQualitySnapshots DataQualitySnapshot[]
}

model Account {
  id String @id @default(uuid())
  userId String
  provider AuthProvider
  providerAccountId String
  accessTokenEncrypted String?
  refreshTokenEncrypted String?
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
  @@unique([userId, provider, providerAccountId])
  @@index([userId])
}

model IdentityProvider {
  id String @id @default(uuid())
  name String @unique
  provider AuthProvider
  issuerUrl String
  discoveryUrl String?
  clientId String
  clientSecretEncrypted String?
  scopes String?
  enabled Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([provider, enabled])
}
model Organization {
  id String @id @default(uuid())
  name String
  legalName String?
  englishName String?
  displayName String?
  type OrganizationType @default(OTHER)
  status OrganizationStatus @default(ACTIVE)
  industry String?
  country String?
  city String?
  address String?
  website String?
  phone String?
  email String?
  strategicImportance Int @default(0)
  registrationId String?
  parentOrganizationId String?
  parentOrganization Organization? @relation("OrgHierarchy", fields: [parentOrganizationId], references: [id])
  children Organization[] @relation("OrgHierarchy")
  memberships Membership[]
  units OrganizationUnit[]
  contacts ContactInformation[]
  sourceRelationships Relationship[] @relation("SourceRelationship")
  targetRelationships Relationship[] @relation("TargetRelationship")
  sourcePersonRelationships PersonRelationship[] @relation("SourcePersonOrgRelationship")
  targetPersonRelationships PersonRelationship[] @relation("TargetPersonOrgRelationship")
  people Person[]
  organizationPeople OrganizationPerson[]
  interactions Interaction[]
  meetings Meeting[]
  actions Action[]
  projects Project[]
  opportunities Opportunity[]
  requirements ProjectRequirement[]
  commitments Commitment[]
  notes Note[]
  documents Document[]
  deletedAt DateTime?
  deletedById String?
  deletedBy User? @relation("OrganizationDeletedBy", fields: [deletedById], references: [id])
  auditLogs AuditLog[]
  securityEvents SecurityEvent[]
  dataExports DataExportLog[]
  dataImports DataImport[] @relation("DataImportOrganization")
  dataQualitySnapshotsForOrganization DataQualitySnapshot[] @relation("DataQualityOrganization")
  integrationConnections IntegrationConnection[]
  workflows Workflow[]
  approvalRequests ApprovalRequest[] @relation("ApprovalRequestOrganization")

  authorizationPolicies AuthorizationPolicy[]
  tagAssignments TagAssignment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ownerId String?
  owner User? @relation("OrganizationOwner", fields: [ownerId], references: [id])
  @@index([name])
  @@index([parentOrganizationId])
  @@index([registrationId])
  @@index([deletedAt])
  @@index([parentOrganizationId, deletedAt, id])
  customFields CustomField[] @relation("CustomFieldOrganization")
  scoringRules ScoringRule[] @relation("ScoringRuleOrganization")
  notificationRules NotificationRule[] @relation("NotificationRuleOrganization")
  aiSettings AiSetting[] @relation("AiSettingOrganization")
  analyticsEvents AnalyticsEvent[]
  featureFlags FeatureFlag[]
  referralsFrom Referral[] @relation("ReferralSourceOrganization")
  referralsTo Referral[] @relation("ReferralTargetOrganization")
  projectRisks ProjectRisk[]
  connectionPathsFrom ConnectionPath[] @relation("ConnectionPathSourceOrganization")
  connectionPathsTo ConnectionPath[] @relation("ConnectionPathTargetOrganization")
}
model OrganizationUnit {
  id String @id @default(uuid())
  organizationId String
  parentUnitId String?
  name String
  type String @default("DEPARTMENT")
  status String @default("ACTIVE")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parentUnit OrganizationUnit? @relation("UnitHierarchy", fields: [parentUnitId], references: [id])
  children OrganizationUnit[] @relation("UnitHierarchy")
  contacts ContactInformation[]
  memberships Membership[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([organizationId, status])
  @@index([parentUnitId])
}

model ContactInformation {
  id String @id @default(uuid())
  organizationId String?
  personId String?
  organizationUnitId String?
  kind String
  value String
  label String?
  isPrimary Boolean @default(false)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  person Person? @relation(fields: [personId], references: [id], onDelete: Cascade)
  organizationUnit OrganizationUnit? @relation(fields: [organizationUnitId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([organizationId, kind])
  @@index([personId, kind])
  @@index([organizationUnitId, kind])
}

model RelationshipType {
  id String @id @default(uuid())
  key String @unique
  name String
  description String?
  isActive Boolean @default(true)
  relationships Relationship[]
  personRelationships PersonRelationship[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("RelationshipTypeCatalog")
}

model InteractionType {
  id String @id @default(uuid())
  key InteractionKind @unique
  name String
  description String?
  isActive Boolean @default(true)
  interactions Interaction[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id String @id @default(uuid())
  key String @unique
  name String
  description String?
  isSystem Boolean @default(true)
  isActive Boolean @default(true)
  rolePermissions RolePermission[]
  memberships Membership[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([isActive])
}

model Membership {
  id String @id @default(uuid())
  userId String
  organizationId String
  role String @default("STANDARD_USER")
  roleRef Role @relation(fields: [role], references: [key], onDelete: Restrict)
  department String?
  departmentUnitId String?
  departmentUnit OrganizationUnit? @relation(fields: [departmentUnitId], references: [id], onDelete: SetNull)
  dataScope DataClassification @default(INTERNAL)
  accessScope AccessScopeType @default(ORGANIZATION)
  scope Json?
  isPrimary Boolean @default(false)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([userId, organizationId])
  @@index([organizationId, role])
  @@index([userId, isPrimary])
  @@index([departmentUnitId])
  @@index([userId, accessScope])
}
model OrganizationPerson {
  id String @id @default(uuid())
  organizationId String
  personId String
  roleTitle String?
  department String?
  isPrimary Boolean @default(false)
  status String @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([organizationId, personId])
  @@index([personId, status])
  @@index([organizationId, status])
  @@index([personId, isPrimary])
}

model Person {
  id String @id @default(uuid())
  firstName String
  lastName String
  email String?
  phone String?
  title String?
  displayName String?
  department String?
  country String?
  notesText String? @map("notes")
  status String @default("ACTIVE")
  contacts ContactInformation[]
  influenceScore Int @default(0)
  decisionPower Int @default(0)
  accessibilityScore Int @default(0)
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id])
  organizationPeople OrganizationPerson[]
  interactions Interaction[]
  meetingParticipants MeetingParticipant[]
  actions Action[]
  commitments Commitment[]
  notes Note[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  deletedById String?
  deletedBy User? @relation("PersonDeletedBy", fields: [deletedById], references: [id])
  @@index([organizationId])
  @@index([email])
  @@index([lastName, firstName])
  @@index([organizationId, deletedAt, id])
  referralsFrom Referral[] @relation("ReferralSourcePerson")
  referralsTo Referral[] @relation("ReferralTargetPerson")
  sourcePersonRelationships PersonRelationship[] @relation("SourcePersonRelationship")
  targetPersonRelationships PersonRelationship[] @relation("TargetPersonRelationship")
  @@index([deletedAt])
}
model PersonRelationship {
  id String @id @default(uuid())
  sourcePersonId String
  targetPersonId String
  sourceOrganizationId String
  targetOrganizationId String
  relationshipType String
  relationshipTypeId String?
  relationshipTypeRef RelationshipType? @relation(fields: [relationshipTypeId], references: [id], onDelete: Restrict)
  status RelationshipStatus @default(PROSPECTIVE)
  healthScore Int @default(0)
  strategicScore Int @default(0)
  riskScore Int @default(0)
  trustScore Int @default(0)
  accessScore Int @default(0)
  influenceScore Int @default(0)
  opportunityScore Int @default(0)
  resilienceScore Int @default(0)
  sensitivity DataClassification @default(INTERNAL)
  engagementScore Int @default(0)
  ownerId String?
  backupOwnerId String?
  reviewCadenceDays Int @default(90)
  lastInteractionAt DateTime?
  nextReviewAt DateTime?
  nextActionAt DateTime?
  sourcePerson Person @relation("SourcePersonRelationship", fields: [sourcePersonId], references: [id])
  targetPerson Person @relation("TargetPersonRelationship", fields: [targetPersonId], references: [id])
  sourceOrganization Organization @relation("SourcePersonOrgRelationship", fields: [sourceOrganizationId], references: [id])
  targetOrganization Organization @relation("TargetPersonOrgRelationship", fields: [targetOrganizationId], references: [id])
  owner User? @relation("PersonRelationshipOwner", fields: [ownerId], references: [id])
  backupOwner User? @relation("PersonRelationshipBackupOwner", fields: [backupOwnerId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  deletedById String?
  deletedBy User? @relation("PersonRelationshipDeletedBy", fields: [deletedById], references: [id])
  @@unique([sourcePersonId, targetPersonId, relationshipType])
  @@index([sourceOrganizationId, targetOrganizationId])
  @@index([status])
  @@index([ownerId])
  @@index([sourcePersonId])
  @@index([targetPersonId])
  @@index([deletedAt])
  @@index([sourcePersonId, deletedAt, status])
  @@index([targetPersonId, deletedAt, status])
}

model Relationship {
  id String @id @default(uuid())
  sourceOrganizationId String
  targetOrganizationId String
  relationshipType String
  relationshipTypeId String?
  relationshipTypeRef RelationshipType? @relation(fields: [relationshipTypeId], references: [id], onDelete: Restrict)
  status RelationshipStatus @default(PROSPECTIVE)
  lifecycleStage RelationshipLifecycleStage @default(IDENTIFIED)
  healthScore Int @default(0)
  strategicScore Int @default(0)
  riskScore Int @default(0)
  trustScore Int @default(0)
  accessScore Int @default(0)
  influenceScore Int @default(0)
  opportunityScore Int @default(0)
  resilienceScore Int @default(0)
  sensitivity DataClassification @default(INTERNAL)
  engagementScore Int @default(0)
  ownerId String?
  backupOwnerId String?
  reviewCadenceDays Int @default(90)
  lastInteractionAt DateTime?
  nextReviewAt DateTime?
  nextActionAt DateTime?
  sourceOrganization Organization @relation("SourceRelationship", fields: [sourceOrganizationId], references: [id])
  targetOrganization Organization @relation("TargetRelationship", fields: [targetOrganizationId], references: [id])
  owner User? @relation("RelationshipOwner", fields: [ownerId], references: [id])
  backupOwner User? @relation("RelationshipBackupOwner", fields: [backupOwnerId], references: [id])
  interactions Interaction[]
  meetings Meeting[]
  actions Action[]
  commitments Commitment[]
  projects ProjectRelationship[]
  scoreSnapshots RelationshipScoreSnapshot[]
  recommendations Recommendation[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  deletedById String?
  deletedBy User? @relation("RelationshipDeletedBy", fields: [deletedById], references: [id])
  @@unique([sourceOrganizationId, targetOrganizationId, relationshipType])
  @@index([status])
  @@index([lifecycleStage])
  @@index([healthScore])
  @@index([ownerId])
  @@index([deletedAt])
  @@index([sourceOrganizationId, deletedAt, status])
  @@index([targetOrganizationId, deletedAt, status])
  @@index([sourceOrganizationId, targetOrganizationId, healthScore])
  calibrations ScoreCalibration[]
  referrals Referral[]
  tags RelationshipTag[]

  opportunities Opportunity[] @relation("RelationshipOpportunity")
}

model Score {
  id String @id @default(uuid())
  type String
  subjectType String
  subjectId String
  value Float
  version Int @default(1)
  explanation String?
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  snapshots ScoreSnapshot[]
  @@index([type, subjectType, subjectId])
  @@index([subjectType, subjectId, createdAt])
}

model ScoreSnapshot {
  id String @id @default(uuid())
  scoreId String
  value Float
  version Int
  explanation String?
  metadata Json?
  createdAt DateTime @default(now())
  score Score @relation(fields: [scoreId], references: [id], onDelete: Cascade)
  @@index([scoreId, createdAt])
}

model ScoreVersion {
  id String @id @default(uuid())
  name String
  version Int
  status String @default("DRAFT")
  weights Json
  calibrationNotes String?
  createdById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy User? @relation("ScoreVersionCreator", fields: [createdById], references: [id])
  @@unique([name, version])
  @@index([status])
  calibrations ScoreCalibration[]
}

model ScoreCalibration {
  id String @id @default(uuid())
  scoreVersionId String
  relationshipId String?
  observedOutcome String
  expectedScore Int
  observedScore Int
  notes String?
  createdAt DateTime @default(now())
  scoreVersion ScoreVersion @relation(fields: [scoreVersionId], references: [id], onDelete: Cascade)
  relationship Relationship? @relation(fields: [relationshipId], references: [id])
  @@index([scoreVersionId, createdAt])
  @@index([relationshipId])
}

model RelationshipScoreSnapshot {
  id String @id @default(uuid())
  relationshipId String
  healthScore Int
  strategicScore Int
  riskScore Int
  trustScore Int
  accessScore Int
  influenceScore Int
  opportunityScore Int
  resilienceScore Int
  engagementScore Int
  reason String?
  createdAt DateTime @default(now())
  relationship Relationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  @@index([relationshipId, createdAt])
}
model Interaction {
  id String @id @default(uuid())
  type InteractionKind
  interactionTypeId String?
  interactionType InteractionType? @relation(fields: [interactionTypeId], references: [id], onDelete: Restrict)
  subject String
  summary String?
  outcome String?
  durationMinutes Int?
  followUpRequired Boolean @default(false)
  followUpAt DateTime?
  attachments Json?
  importance Priority @default(MEDIUM)
  sentiment Int?
  occurredAt DateTime @default(now())
  userId String
  organizationId String?
  personId String?
  relationshipId String?
  user User @relation(fields: [userId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])
  person Person? @relation(fields: [personId], references: [id])
  relationship Relationship? @relation(fields: [relationshipId], references: [id])
  deletedAt DateTime?
  deletedById String?
  deletedBy User? @relation("InteractionDeletedBy", fields: [deletedById], references: [id])
  createdAt DateTime @default(now())
  @@index([occurredAt])
  @@index([relationshipId])
  @@index([organizationId])
  @@index([deletedAt])
}
model Meeting {
