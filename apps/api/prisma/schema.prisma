  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  notificationRule NotificationRule @relation(fields: [notificationRuleId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification Notification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  @@unique([notificationRuleId, eventId, userId, channel])
  @@index([eventId, status])
  @@index([userId, createdAt])
}

