/// اشتراک Web Push کاربر (طبق استاندارد W3C Push API). بدون این رکورد،
/// Provider واقعی Push (WebPushNotificationProvider) هیچ مقصدی برای ارسال
/// ندارد؛ کلاینت (Web/Mobile) باید پس از دریافت اجازه از مرورگر/دستگاه،
/// این Endpoint را از طریق API ثبت کند.
model PushSubscription {
  id String @id @default(uuid())
  userId String
  endpoint String @unique
  p256dh String
  auth String
  userAgent String?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}
/// لاگ واقعی و قابل‌جست‌وجوی هر تلاش برای ارسال Email/Push/In-App، صرف‌نظر
/// از این‌که Providerِ پیکربندی‌شده موفق شد یا نه. این جدول جایگزین رفتار
/// قبلی است که NoopNotificationProvider نتیجه را بی‌سروصدا دور می‌ریخت.
model NotificationDeliveryLog {
  id String @id @default(uuid())
  userId String
  channel String
  provider String
  accepted Boolean
  title String
  errorMessage String?
  notificationRuleId String?
  eventId String?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@index([channel, accepted])
  @@index([notificationRuleId, eventId])
}

