FROM node:22-alpine AS build
WORKDIR /workspace
RUN corepack enable
ARG NEXT_PUBLIC_API_URL=/api/v1
ARG API_PROXY_TARGET=http://api:4000
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL API_PROXY_TARGET=$API_PROXY_TARGET
COPY . .
RUN pnpm install --frozen-lockfile=false
RUN pnpm --filter @srip/web build

FROM node:22-alpine AS runtime
WORKDIR /workspace
RUN corepack enable
RUN addgroup -S srip && adduser -S srip -G srip
ENV NODE_ENV=production
COPY --from=build /workspace /workspace
USER srip
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=5s --retries=10 CMD node -e "fetch('http://127.0.0.1:3000').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["pnpm","--filter","@srip/web","start"]
