FROM node:22-alpine AS build
WORKDIR /workspace
RUN corepack enable
COPY . .
RUN pnpm install --frozen-lockfile=false
RUN pnpm --filter @srip/api prisma:generate && pnpm --filter @srip/api build

FROM node:22-alpine AS runtime
WORKDIR /workspace
RUN corepack enable
RUN addgroup -S srip && adduser -S srip -G srip
ENV NODE_ENV=production
COPY --from=build /workspace /workspace
USER srip
EXPOSE 4000
HEALTHCHECK --interval=10s --timeout=5s --retries=10 CMD node -e "fetch('http://127.0.0.1:4000/api/v1/health/live').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["pnpm","--filter","@srip/api","start"]
